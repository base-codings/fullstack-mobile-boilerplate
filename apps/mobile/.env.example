# Copy this file to apps/mobile/.env (gitignored). Never commit real .env.
#
# API_BASE_URL=auto  →  AppEnv resolves at runtime:
#   - Android emulator → http://10.0.2.2:3000  (host loopback)
#   - iOS sim / macOS / web → http://localhost:3000
#
# Override with an explicit URL for LAN testing on real device, staging, or prod.
# Example: API_BASE_URL=https://api.staging.example.com
#
# <!-- Red Team #11, #15 -->: Only non-secret runtime config goes here.
# Secrets (Sentry DSN, analytics tokens, API keys) MUST come from
# flutter_secure_storage — NOT from .env (bundled in APK, extractable via unzip).

API_BASE_URL=auto
API_PREFIX=/api
