// Prisma schema — initial state intentionally empty.
//
// Boilerplate ships zero models. Adopters add their first model by following
// docs/guides/add-prisma-module.md (created in Phase 11).
//
// Connection strings live in apps/api/.env:
//   DATABASE_URL  — pooled (PgBouncer transaction mode, port 6543) for runtime
//   DIRECT_URL    — direct (port 5432) for migrations
//
// Set SKIP_DB=true in .env to boot the API without a database connection
// (used by the OpenAPI codegen pipeline; see tools/codegen/export-openapi.ts).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Add models below. See docs/guides/prisma-module.md.

// =====================================================================
// PLACEHOLDER MODEL — DELETE THIS WHEN ADDING YOUR FIRST REAL MODEL.
// Prisma requires at least one model to generate @prisma/client. Without
// the generated client, PrismaService can't bootstrap (super() crashes)
// even when SKIP_DB=true (which only short-circuits $connect, not the
// constructor). This stub satisfies the requirement until adopters
// define real models.
// =====================================================================
model BoilerplatePlaceholder {
  id String @id @default(cuid())
}
