# Copy to apps/api/.env. Never commit the real .env (gitignored).

NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
LOG_LEVEL=debug

# Opt-in Swagger UI for non-development environments.
# In development Swagger is always enabled regardless of this flag.
# ENABLE_SWAGGER=true

# --- Database (Phase 03) ---
# Supabase: Project Settings → Database → Connection string.
# Pooled (PgBouncer transaction mode, port 6543) for runtime queries:
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct (port 5432) — required for migrations:
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Set SKIP_DB=true to boot the API without a database (used by codegen).
# SKIP_DB=true

# Number of proxy hops in front of the API. Set to 1 if behind a load balancer
# (Cloudflare, ALB, Render, Fly.io). Affects req.ip resolution → throttler/logs.
TRUST_PROXY=0

# JSON/urlencoded body size limit. DoS hardening. Use multer for file uploads.
BODY_LIMIT=1mb
